<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Таблица пользователей -->
    <changeSet id="1" author="yourname">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Таблица фильмов -->
    <changeSet id="2" author="yourname">
        <createTable tableName="movie">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="movie_title" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="genre" type="VARCHAR(255)"/>
            <column name="emotion" type="VARCHAR(255)"/>
            <column name="director" type="VARCHAR(255)"/>
            <column name="movie_year" type="INT"/>
        </createTable>
    </changeSet>

    <!-- Таблица оценок -->
    <changeSet id="3" author="yourname">
        <createTable tableName="user_movie_rating">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="movie_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="NUMERIC(3,1)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="user_movie_rating"
                baseColumnNames="user_id"
                referencedTableName="app_user"
                referencedColumnNames="id"
                constraintName="fk_user_rating_user"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="user_movie_rating"
                baseColumnNames="movie_id"
                referencedTableName="movie"
                referencedColumnNames="id"
                constraintName="fk_user_rating_movie"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="user_movie_rating"
                columnNames="user_id, movie_id"
                constraintName="uk_user_movie_rating_unique"/>
    </changeSet>

</databaseChangeLog>